# API
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Club Social Costa Verde

# ─────────────────────────────────────────────────────────────────────────────
# BRAND (white-label) — opcionales. Si no se definen, se usa la marca real
# la marca ficticia por defecto de lib/branding.ts.
# Para la demo de portafolio se fijan en la rama `demo`.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_SHORT_NAME=
