# Core
NODE_ENV=development
PORT=4000

# Database
# Local (docker-compose): postgresql://socialclub_user:socialclub_pass@localhost:5433/socialclub_dev
DATABASE_URL=
DATABASE_POOL_MAX=20
# TLS explícito: activo por defecto en producción. Opciones: true/false
DATABASE_SSL=true
# Forzar verificación del certificado (verify-full). false = aceptar certs managed (Aiven).
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Subscription
SUBSCRIPTION_PRICE_1M=150
SUBSCRIPTION_PRICE_3M=450
SUBSCRIPTION_PRICE_6M=900
SUBSCRIPTION_PRICE_12M=1440
GRACE_PERIOD_DAYS=5
MAX_ASSOCIATES=6
MAX_RESERVATIONS_PER_WEEK=2

# Capacity
GLOBAL_DAILY_CAPACITY=500

# Club local timezone (dates, grace period, 48h window)
CLUB_TIMEZONE=America/Havana
# Nombre del club en notificaciones al usuario (branding white-label)
CLUB_NAME=Club Social Costa Verde

# Dev only: return the password reset link in the API response when email is not sent.
# Ignored in production.
PASSWORD_RESET_DEV_URL=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Payment (Transfermóvil)
TRANSFERMOVIL_QR_URL=
